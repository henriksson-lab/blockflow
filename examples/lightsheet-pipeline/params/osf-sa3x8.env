# osf-sa3x8: vasculature, Brain-39L. 9 tiles (rows 03-05, columns 04-06 of a
# 6 x 12 mosaic), 3369 x 1304 x 404 at 1.6 x 1.625 x 1.625 um, two channels
# (0 vessels, 1 arteries), and the autofluorescence (6 x 5 x 5 um).
#   run.sh /husky/henriksson/lightsheet-reference/positions/osf-sa3x8 params/osf-sa3x8.env
# The sample directory is the metadata-only mirror whose tiles carry their
# LaVision stage positions (img2omezarr set-positions --from-originals), so
# no STITCH_OVERLAP is given.
SAMPLE_ID=osf-sa3x8
SIGNAL_TILES=tiles
SIGNAL_CHANNEL=0
AUTOFLUORESCENCE=autofluorescence.zarr
# Prepared for this sample's orientation (1, -2, 3), one hemisphere (z 0:256).
ATLAS=/husky/henriksson/lightsheet-reference/atlas/ABA_25um_2017_1_-2_3_z0-256.ome.zarr
STITCH_LEVEL=1
STITCH_MAX_SHIFT=8,15
STITCH_RIGID_MAX_SHIFT=15,15
STITCH_MAX_SHIFT_Z=20
# The tile pyramid halves z too (unlike osf-cztq2), and the per-slice
# placement keeps z, so the whole fusion is at the alignment level.
FUSE_LEVEL=1
SIGNAL_TO_AUTO="align_affine.txt"
AUTO_TO_ATLAS="align_affine.txt align_bspline.txt"
VESSELS=1
VESSEL_CHANNELS="0 1"
VESSEL_ROLES="vessel,artery"
# The nine tiles are a strip of the autofluorescence field, which carries no
# stage position (not part of a mosaic, <Offset> 0): started from the centres
# the affine cannot find the strip. The registration finds the translation
# itself (atlas-registration --initialise search: a coarse-to-fine normalised
# cross-correlation, see the README); an explicit Z,Y,X here overrides it
# (the hand-measured 0,3420,4535 um of the first run).
SIGNAL_TO_AUTO_INITIAL=search
# A level-0 box (fused voxels, 1.6 x 1.625 x 1.625 um) from above the dorsal
# surface down about 0.5 mm into the cortex: the surface crosses it at about
# z 250-450.
VESSEL_REGION=160:672,896:1408,320:576
