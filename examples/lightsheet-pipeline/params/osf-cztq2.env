# osf-cztq2: cFos (40 tiles, 8 rows x 5 columns, 1030 x 1007 x 1004 at
# 6 x 1.625 x 1.625 um) and its autofluorescence (6 x 5 x 5 um).
#   run.sh /husky/otherdataset/teresa/clearmap_em/osf-cztq2 params/osf-cztq2.env
SAMPLE_ID=osf-cztq2
SIGNAL_TILES=cFos
AUTOFLUORESCENCE=autofluorescence.zarr
# Prepared for this sample's orientation (1, 2, 3), one hemisphere (z 0:256).
ATLAS=/husky/henriksson/lightsheet-reference/atlas/ABA_25um_2017_1_2_3_z0-256.ome.zarr
# The tiles carry no translations; they overlap by about 120 level-0 voxels in
# y and x (measured from the whole-sample stitch).
STITCH_OVERLAP=120,120
STITCH_LEVEL=1
# The reference's searches (stitching.yml v3.1) halved for level 1.
STITCH_MAX_SHIFT=8,15
STITCH_RIGID_MAX_SHIFT=15,15
STITCH_MAX_SHIFT_Z=20
FUSE_LEVEL=2
# The reference's CellMap: signal -> auto affine, auto -> atlas affine + B-spline.
SIGNAL_TO_AUTO="align_affine.txt"
AUTO_TO_ATLAS="align_affine.txt align_bspline.txt"
CELLS=1
# The window of the earlier hand-offset check (cells-atlas/), in tile 01x02's
# own voxels.
CELL_TILE=01x02
CELL_TILE_BOX=256:768,192:832,192:832
